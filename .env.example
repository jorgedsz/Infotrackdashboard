# Credenciales de GoHighLevel (LeadConnector API v2)
# Copia este archivo a .env y rellena los valores.

# Token de acceso. Recomendado: "Private Integration" token desde
# GHL > Settings > Private Integrations (empieza por "pit-...").
GHL_TOKEN=

# ID de la location (sub-cuenta) en GHL.
GHL_LOCATION_ID=

# Qué pipelines usa el dashboard YA NO se configura acá: se elige desde
# Pipeline Comercial -> Configuración (solo admin) y queda en la base de datos.
# Estas dos variables solo actúan como SEMILLA la primera vez que se arranca con
# la base de datos vacía. Descubre los ids en GET /api/ghl/pipelines.

# Semilla del pipeline COMERCIAL. Vacío = todas las oportunidades de la cuenta.
GHL_PIPELINE_ID=

# Semilla de los pipelines IA (uno por agente); admite varios ids separados por coma.
GHL_PIPELINE_IA=

# Tope de contactos a consultar por refresh para traer citas. Es compartido
# entre todos los pipelines IA: súbelo si agregas agentes y quedan citas fuera.
MAX_CONTACTOS_CITA=300

# Puerto del backend y cada cuánto refresca desde GHL (ms).
PORT=3001
REFRESH_MS=30000

# --- Autenticación (base de datos) ---
# Si DATABASE_URL está presente, se activa el login y se protegen los datos.
# En Railway, agrega un Postgres y usa su DATABASE_URL.
DATABASE_URL=
# Secreto para firmar los tokens de sesión (cualquier cadena larga y aleatoria).
JWT_SECRET=
# Admin inicial (se crea automáticamente al arrancar si no existe).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
